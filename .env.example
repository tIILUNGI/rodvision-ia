# Copy to .env and fill in only what you need. Never commit .env.
#
# Dataset generation, ground truth, question generation, validators and
# Harbor export work WITHOUT any of these variables.

# OpenAI-compatible multimodal endpoint (OpenAI, OpenRouter, vLLM, etc.)
ROADVISION_API_KEY=
ROADVISION_BASE_URL=https://api.openai.com/v1
ROADVISION_MODEL=

# Network behaviour
ROADVISION_TIMEOUT_SEC=60
ROADVISION_MAX_RETRIES=3

# Optional cost accounting. Leave empty to record token usage only.
# Values are USD per one million tokens.
ROADVISION_INPUT_COST_PER_MTOK=
ROADVISION_OUTPUT_COST_PER_MTOK=
